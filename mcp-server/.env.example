# Agentic Automation Garage v2 - Environment Configuration

# Microsoft Teams Configuration
TEAMS_WEBHOOK_URL=https://your-organization.webhook.office.com/webhookb2/your-webhook-id

# Slack Configuration  
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email Configuration
APPROVAL_EMAIL=sandeep.singh@bauermediaoutdoor.com

# JIRA Configuration
JIRA_BASE_URL=https://cci-clearchannel.atlassian.net/browse
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=CLOUDREQ

# Halo PSA Configuration (optional)
HALO_API_KEY=your-halo-api-key-here
HALO_BASE_URL=https://your-halo-instance.haloservicedesk.com

# Debug Configuration
DEBUG=false
LOG_LEVEL=INFO

# Claude.ai Configuration
MCP_SERVER_NAME=agentic-automation-garage-v2
MCP_SERVER_VERSION=2.0.0

# Security Configuration
ENABLE_WEBHOOK_VALIDATION=true
WEBHOOK_SECRET=your-webhook-secret-here

# Performance Configuration
HTTP_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60