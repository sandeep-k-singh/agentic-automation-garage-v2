  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.11.0"
  },
  "dependencies": {},
  "devDependencies": {},
  "python-dependencies": {
    "httpx": ">=0.25.0",
    "pydantic": ">=2.0.0",
