{
  "name": "agentic-automation-garage-v2",
  "version": "2.0.0",
  "description": "Multi-agentic automation platform for enterprise workflow management with Claude.ai integration",
  "main": "mcp-server/teams_mcp_server.py",
  "scripts": {
    "start": "cd mcp-server && python teams_mcp_server.py",
    "test": "cd mcp-server && python -m pytest tests/",
    "install-deps": "cd mcp-server && pip install -r requirements.txt",
    "setup": "cd mcp-server && cp .env.example .env",
    "test-teams": "cd mcp-server && python -c 'import test_teams_integration; test_teams_integration.main()'",
    "test-slack": "node test-slack-integration.js",
    "validate-skills": "python scripts/validate-skills.py",
    "deploy-check": "python scripts/deployment-check.py"
  },
  "keywords": [
    "automation",
    "workflow",
    "claude-ai",
    "mcp-server",
    "teams",
    "slack",
    "jira",
    "enterprise",
    "approval-workflow"
  ],
  "author": "Agentic Automation Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/agentic-automation-garage-v2"
  },
  "bugs": {
